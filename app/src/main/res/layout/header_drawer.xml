<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="270dp"
    android:background="@color/verde_oscuro"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="104dp"
        android:layout_height="104dp"
        app:cardBackgroundColor="@color/verde_suave"
        app:cardCornerRadius="52dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/imgLogoDrawer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_alt"
            android:contentDescription="Logo de Per Tour" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/txtTituloDrawer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="Per Tour"
        android:textColor="@color/blanco"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtSubtituloDrawer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Vive la aventura, descubre el Perú"
        android:textColor="@color/texto_claro"
        android:textSize="18sp"
        android:lineSpacingExtra="3dp" />

</LinearLayout>
